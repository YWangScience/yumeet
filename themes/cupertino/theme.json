{
  "$schema": "https://yumeet.dev/schemas/theme.v1.json",
  "name": "@yumeet/theme-cupertino",
  "id": "cupertino",
  "displayName": { "zh": "Cupertino", "en": "Cupertino" },
  "description": {
    "zh": "内置默认主题:大留白、系统字体、克制的单一强调色、毛玻璃导航。全站视觉基准(ch07 §7.4)。",
    "en": "The built-in default: generous whitespace, system fonts, one restrained accent colour, frosted-glass navigation."
  },
  "version": "1.0.0",
  "license": "MIT",
  "kind": "tokens",
  "engines": { "yumeet": ">=1.0.0 <2.0.0" },
  "darkMode": "auto",
  "tokens": {
    "light": {
      "--yu-font-family-base": "system-ui, -apple-system, \"SF Pro Text\", \"Segoe UI\", \"Helvetica Neue\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif",
      "--yu-font-family-mono": "ui-monospace, \"SF Mono\", SFMono-Regular, Menlo, Consolas, monospace",

      "--yu-text-display-1-size": "80px",
      "--yu-text-display-1-weight": "600",
      "--yu-text-display-1-tracking": "-0.015em",
      "--yu-text-display-1-leading": "1.05",
      "--yu-text-display-2-size": "56px",
      "--yu-text-display-2-weight": "600",
      "--yu-text-display-2-tracking": "-0.012em",
      "--yu-text-display-2-leading": "1.07",
      "--yu-text-title-1-size": "48px",
      "--yu-text-title-1-weight": "600",
      "--yu-text-title-1-tracking": "-0.008em",
      "--yu-text-title-1-leading": "1.08",
      "--yu-text-title-2-size": "40px",
      "--yu-text-title-2-weight": "600",
      "--yu-text-title-2-tracking": "-0.005em",
      "--yu-text-title-2-leading": "1.10",
      "--yu-text-title-3-size": "28px",
      "--yu-text-title-3-weight": "600",
      "--yu-text-title-3-tracking": "0",
      "--yu-text-title-3-leading": "1.14",
      "--yu-text-headline-size": "21px",
      "--yu-text-headline-weight": "600",
      "--yu-text-headline-tracking": "0.011em",
      "--yu-text-headline-leading": "1.30",
      "--yu-text-body-large-size": "21px",
      "--yu-text-body-large-weight": "400",
      "--yu-text-body-large-tracking": "0.011em",
      "--yu-text-body-large-leading": "1.45",
      "--yu-text-body-size": "17px",
      "--yu-text-body-weight": "400",
      "--yu-text-body-tracking": "-0.022em",
      "--yu-text-body-leading": "1.60",
      "--yu-text-callout-size": "15px",
      "--yu-text-callout-weight": "400",
      "--yu-text-callout-tracking": "-0.016em",
      "--yu-text-callout-leading": "1.45",
      "--yu-text-footnote-size": "14px",
      "--yu-text-footnote-weight": "400",
      "--yu-text-footnote-tracking": "-0.012em",
      "--yu-text-footnote-leading": "1.42",
      "--yu-text-caption-size": "12px",
      "--yu-text-caption-weight": "400",
      "--yu-text-caption-tracking": "0",
      "--yu-text-caption-leading": "1.35",

      "--yu-space-1": "4px",
      "--yu-space-2": "8px",
      "--yu-space-3": "12px",
      "--yu-space-4": "16px",
      "--yu-space-5": "20px",
      "--yu-space-6": "24px",
      "--yu-space-8": "32px",
      "--yu-space-10": "40px",
      "--yu-space-12": "48px",
      "--yu-space-16": "64px",
      "--yu-space-20": "80px",
      "--yu-space-24": "96px",

      "--yu-radius-control": "10px",
      "--yu-radius-card": "18px",
      "--yu-radius-pill": "980px",

      "--yu-color-bg-page": "#ffffff",
      "--yu-color-bg-section": "#f5f5f7",
      "--yu-color-bg-elevated": "#ffffff",
      "--yu-color-text-primary": "#1d1d1f",
      "--yu-color-text-secondary": "#6e6e73",
      "--yu-color-hairline": "#d2d2d7",
      "--yu-color-accent": "#0071e3",
      "--yu-color-accent-hover": "#0077ed",
      "--yu-color-accent-text": "#0062cc",
      "--yu-color-success-fill": "#34c759",
      "--yu-color-success-text": "#1a6b2e",
      "--yu-color-warning-fill": "#ff9500",
      "--yu-color-warning-text": "#a32b00",
      "--yu-color-danger-fill": "#ff3b30",
      "--yu-color-danger-text": "#d70015",
      "--yu-color-focus-ring": "#0071e3",
      "--yu-color-focus-ring-soft": "rgba(0, 113, 227, 0.18)"
    },
    "dark": {
      "--yu-color-bg-page": "#000000",
      "--yu-color-bg-section": "#161617",
      "--yu-color-bg-elevated": "#1d1d1f",
      "--yu-color-text-primary": "#f5f5f7",
      "--yu-color-text-secondary": "#86868b",
      "--yu-color-hairline": "rgba(255, 255, 255, 0.16)",
      "--yu-color-accent": "#2997ff",
      "--yu-color-accent-hover": "#4dabff",
      "--yu-color-accent-text": "#4dabff",
      "--yu-color-success-fill": "#30d158",
      "--yu-color-success-text": "#30d158",
      "--yu-color-warning-fill": "#ff9f0a",
      "--yu-color-warning-text": "#ff9f0a",
      "--yu-color-danger-fill": "#ff453a",
      "--yu-color-danger-text": "#ff453a",
      "--yu-color-focus-ring": "#2997ff",
      "--yu-color-focus-ring-soft": "rgba(41, 151, 255, 0.22)"
    }
  },
  "settings": [
    {
      "key": "heroStyle",
      "type": "select",
      "label": { "zh": "Hero 布局", "en": "Hero layout" },
      "options": ["centered", "split"],
      "default": "centered"
    },
    {
      "key": "showSponsorBar",
      "type": "boolean",
      "label": { "zh": "显示赞助商栏", "en": "Show sponsor bar" },
      "default": true
    }
  ]
}
