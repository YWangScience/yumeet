{
  "$schema": "https://yumeet.dev/schemas/theme.v1.json",
  "name": "@yumeet/theme-classic",
  "id": "classic",
  "displayName": { "zh": "Classic 学术经典", "en": "Classic" },
  "description": {
    "zh": "学术传统风:衬线标题与正文、近乎方角的边框、暖白纸感底色、深绛红强调色。适合学会年会与论文集式的会议站。",
    "en": "Traditional academic look: serif type, near-square corners, warm paper background and a deep crimson accent. Made for learned-society meetings."
  },
  "version": "1.0.0",
  "license": "MIT",
  "kind": "tokens",
  "engines": { "yumeet": ">=1.0.0 <2.0.0" },
  "extends": "@yumeet/theme-cupertino",
  "darkMode": "auto",
  "tokens": {
    "light": {
      "--yu-font-family-base": "\"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, \"Songti SC\", \"Noto Serif CJK SC\", serif",

      "--yu-text-display-1-size": "64px",
      "--yu-text-display-1-weight": "700",
      "--yu-text-display-1-tracking": "0",
      "--yu-text-display-1-leading": "1.12",
      "--yu-text-display-2-size": "48px",
      "--yu-text-display-2-weight": "700",
      "--yu-text-display-2-tracking": "0",
      "--yu-text-display-2-leading": "1.16",
      "--yu-text-title-1-size": "40px",
      "--yu-text-title-1-weight": "700",
      "--yu-text-title-1-tracking": "0",
      "--yu-text-title-1-leading": "1.18",
      "--yu-text-title-2-size": "32px",
      "--yu-text-title-2-weight": "700",
      "--yu-text-title-2-tracking": "0",
      "--yu-text-title-2-leading": "1.22",
      "--yu-text-title-3-size": "26px",
      "--yu-text-title-3-weight": "700",
      "--yu-text-title-3-tracking": "0",
      "--yu-text-title-3-leading": "1.26",
      "--yu-text-headline-size": "20px",
      "--yu-text-headline-weight": "700",
      "--yu-text-headline-tracking": "0",
      "--yu-text-headline-leading": "1.34",
      "--yu-text-body-large-size": "20px",
      "--yu-text-body-large-tracking": "0",
      "--yu-text-body-large-leading": "1.55",
      "--yu-text-body-size": "17px",
      "--yu-text-body-tracking": "0",
      "--yu-text-body-leading": "1.70",
      "--yu-text-callout-size": "15px",
      "--yu-text-callout-tracking": "0",
      "--yu-text-footnote-size": "14px",
      "--yu-text-footnote-tracking": "0",
      "--yu-text-caption-size": "12px",

      "--yu-radius-control": "2px",
      "--yu-radius-card": "3px",
      "--yu-radius-pill": "4px",

      "--yu-color-bg-page": "#fbf8f1",
      "--yu-color-bg-section": "#f2ece0",
      "--yu-color-bg-elevated": "#fffdf8",
      "--yu-color-text-primary": "#1f1b16",
      "--yu-color-text-secondary": "#57503f",
      "--yu-color-hairline": "#cfc5b0",
      "--yu-color-accent": "#7a1f2b",
      "--yu-color-accent-hover": "#93283a",
      "--yu-color-accent-text": "#6e1c27",
      "--yu-color-success-fill": "#2f6b3f",
      "--yu-color-success-text": "#1f5230",
      "--yu-color-warning-fill": "#b8791b",
      "--yu-color-warning-text": "#7d4a00",
      "--yu-color-danger-fill": "#a32f2a",
      "--yu-color-danger-text": "#8c1f1a",
      "--yu-color-focus-ring": "#7a1f2b",
      "--yu-color-focus-ring-soft": "rgba(122, 31, 43, 0.20)"
    },
    "dark": {
      "--yu-color-bg-page": "#17140f",
      "--yu-color-bg-section": "#1f1b15",
      "--yu-color-bg-elevated": "#24201a",
      "--yu-color-text-primary": "#f2ece0",
      "--yu-color-text-secondary": "#b7ad96",
      "--yu-color-hairline": "rgba(242, 236, 224, 0.18)",
      "--yu-color-accent": "#e79aa2",
      "--yu-color-accent-hover": "#f2b2b9",
      "--yu-color-accent-text": "#e79aa2",
      "--yu-color-success-fill": "#6fbf83",
      "--yu-color-success-text": "#6fbf83",
      "--yu-color-warning-fill": "#e0a33f",
      "--yu-color-warning-text": "#e0a33f",
      "--yu-color-danger-fill": "#e58a84",
      "--yu-color-danger-text": "#e58a84",
      "--yu-color-focus-ring": "#e79aa2",
      "--yu-color-focus-ring-soft": "rgba(231, 154, 162, 0.24)"
    }
  },
  "settings": [
    {
      "key": "heroStyle",
      "type": "select",
      "label": { "zh": "Hero 布局", "en": "Hero layout" },
      "options": ["centered", "split"],
      "default": "centered"
    },
    {
      "key": "showSponsorBar",
      "type": "boolean",
      "label": { "zh": "显示赞助商栏", "en": "Show sponsor bar" },
      "default": false
    }
  ]
}
